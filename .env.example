# Google Analytics 4 Measurement ID for backendtothefuture.com.
# Create a dedicated GA4 property/data stream for this domain and paste its
# ID here (format: G-XXXXXXXXXX). Analytics only loads after the visitor
# accepts the cookie banner. Until a real ID is set, tracking stays inert.
NEXT_PUBLIC_GA_ID=G-XXXXXXXX

MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=<tu-token>

LINKEDIN_CLIENT_ID=<el client id>
LINKEDIN_CLIENT_SECRET=<el client secret>

# Generadas por: npm run linkedin:auth
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_TOKEN_EXPIRES=
